{
  "name": "study-flow",
  "private": true,
  "workspaces": [
    "frontend",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=frontend run dev",
    "dev:mobile": "npm --workspace=mobile run start",
    "dev:mobile:tunnel": "npm --workspace=mobile run tunnel",
    "build:web": "npm --workspace=frontend run build",
    "lint:web": "npm --workspace=frontend run lint",
    "lint:mobile": "npm --workspace=mobile run lint",
    "typecheck:web": "tsc --noEmit -p frontend",
    "typecheck:mobile": "tsc --noEmit -p mobile",
    "doctor:mobile": "node mobile/scripts/doctor.mjs",
    "export:mobile": "cd mobile && npx expo export --platform android --output-dir dist",
    "verify": "node scripts/verify.mjs",
    "prepare": "node scripts/instalar-hooks.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:mutation": "stryker run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:ui": "node scripts/e2e.mjs --ui",
    "release:mobile": "node scripts/release-mobile.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@supabase/supabase-js": "^2.119.2",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "msw": "^2.15.0",
    "pg": "^8.23.1",
    "supabase": "^2.122.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.5"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
