{
  "name": "study-flow",
  "private": true,
  "workspaces": [
    "frontend",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=frontend run dev",
    "dev:mobile": "npm --workspace=mobile run start",
    "dev:mobile:tunnel": "npm --workspace=mobile run tunnel",
    "build:web": "npm --workspace=frontend run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "pg": "^8.23.0",
    "supabase": "^2.112.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  }
}
