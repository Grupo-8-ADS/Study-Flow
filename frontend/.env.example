# Supabase (públicas: vão para o navegador)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Somente servidor: nunca use prefixo NEXT_PUBLIC_ nestas
# Chave secreta (sb_secret_...): login por nome de usuário e integração com o Gmail
SUPABASE_SERVICE_ROLE_KEY=
# OAuth do Gmail (opcional: sem elas a integração aparece como indisponível)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
