# ##############################################################################
# Study Flow - Root .gitignore
# ##############################################################################


# Dependencies
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / React build outputs
.next/
out/
build/
dist/
docs-dist/
.cache/
coverage/

# Debug and Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# LaTeX build outputs (for Docs folder)
*.aux
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# Editor & IDE settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# System files
.DS_Store
Thumbs.db
desktop.ini

# Supabase CLI temp files
supabase/.temp/
.temp/

# Skills and Assistant configs
skills/

# Expo
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
